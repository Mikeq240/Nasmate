{
    // General Editor Settings
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.autoSave": "onWindowChange",
    "editor.autoSaveDelay": 1000,
    "editor.trimAutoWhitespace": true,
    "editor.renderWhitespace": "boundary",
    "editor.lineNumbers": "on",
    "editor.wordWrap": "on",
    "editor.rulers": [
        4,
        80,
        120
    ], // Guides for readability, based on NASM conventions
    "files.autoSave": "onWindowChange",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.eol": "\n", // Ensures Unix-style line endings
    "files.insertFinalNewline": true, // Auto insert newline at the end of the file
    // NASM Specific Language Configuration
    "[nasm]": {
        "editor.defaultFormatter": "ms-vscode.cpptools", // Use C++ formatter for NASM (optional)
        "editor.formatOnSave": true,
        "editor.wordWrap": "on",
        "editor.lineNumbers": "on",
        "editor.minimap.enabled": false, // Minimap is often unnecessary for assembly code
        "editor.cursorStyle": "line",
        "editor.cursorWidth": 2,
        "editor.renderWhitespace": "boundary",
        "editor.renderControlCharacters": true, // Shows non-printable control characters
        "editor.suggestOnTriggerCharacters": true,
        "editor.quickSuggestions": {
            "strings": true
        }
    },
    // Customize File Associations (Make sure NASM files are recognized)
    "files.associations": {
        "*.asm": "nasm",
        "*.inc": "nasm"
    },
    // Enable Syntax Highlighting and Linting
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "entity.name.section.asm",
                "settings": {
                    "foreground": "#FF4500",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "variable.name.asm",
                "settings": {
                    "foreground": "#1E90FF"
                }
            },
            {
                "scope": "keyword.control.asm",
                "settings": {
                    "foreground": "#8A2BE2"
                }
            },
            {
                "scope": "variable.register.asm",
                "settings": {
                    "foreground": "#FFD700"
                }
            },
            {
                "scope": "comment.line.asm",
                "settings": {
                    "foreground": "#2F4F4F",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "constant.numeric.asm",
                "settings": {
                    "foreground": "#32CD32"
                }
            }
        ]
    },
    // Snippets Configuration: Snippet suggestions appear at the top of the list
    "editor.snippetSuggestions": "top",
    "editor.suggestSelection": "first", // Automatically select the first suggestion in the list
    "editor.autoClosingBrackets": "always", // Ensure brackets automatically close
    "editor.autoClosingQuotes": "always", // Ensure quotes automatically close
    // Bracket Matching for NASM
    "editor.matchBrackets": "always", // Enable bracket matching for better code structure understanding
    // Key Bindings for Navigation and Debugging
    "editor.gotoLocation.multiple": "peek", // Use peek for multiple locations navigation
    // Custom NASM Extension Settings
    "nasmExtension.enableSyntaxChecking": true, // Enable basic syntax checking for NASM files
    "nasmExtension.showWarnings": true, // Enable warnings for NASM code (e.g., unused variables, unrecognized opcodes)
    "nasmExtension.showErrors": true, // Show errors in NASM code when applicable
    "nasmExtension.enableAutoFormatting": true, // Enable auto formatting on save for NASM files
    "nasmExtension.autoClearWarningsOnSave": true, // Automatically clear previous warnings when saving
    "nasmExtension.formatOnSave": true, // Automatically format NASM code when saving the file
    // Code Linting and Diagnostics
    "eslint.enable": false, // Disable ESLint for NASM files
    "eslint.validate": [
        "nasm"
    ], // Enable validation for NASM files (if you want to use linting later)
    // Auto Completion: Enhance autocomplete for NASM instructions and registers
    "editor.quickSuggestionsDelay": 100, // Delay for suggestion popup (in ms)
    // File Save and Encoding Settings for NASM files
    "files.encoding": "utf8",
    "files.autoSave": "onWindowChange",
    "files.autoSaveDelay": 1000,
    // Tooltips and Intellisense Configuration for NASM Instructions
    "editor.parameterHints.enabled": true, // Show parameter hints (like for functions or macros)
    "editor.hover.enabled": true, // Enable hovering over instructions and variables for info
    // Enable Notifications for errors, warnings, or successful tasks related to NASM
    "nasmExtension.showNotifications": true
}
